SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key   # backend only, never put in frontend
PORT=3000
AUTO_EXPORT=false   # true = rewrite the Excel file after every admin save

# Google Sheet (live sync after every save/delete)
GOOGLE_SHEET_ID=the-long-id-from-the-sheet-url
GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json   # or paste the whole JSON in GOOGLE_SERVICE_ACCOUNT_JSON
